-- Two Claude Code agents, a writer and a reviewer, on one complier machine.
-- The writer submits a draft; the reviewer's verdict decides what happens next: a rejection sends
-- the work back to the writer, an approval lets it be published, and publishing ends the workflow.
-- Publishing before an approval is denied; acting out of turn (reviewing before anything is
-- submitted, submitting while a draft is in review) is refused, and leaves the state as it was.
datatype Act = submit | review | publish | other
datatype Value = done | failed | approved | rejected
Returns(review) = {approved, rejected, failed}
Returns(_)      = {done, failed}

Policy = Writing

Writing =
     Permit(submit, \ v @ if v == done then InReview else Writing)
  [] Permit(other, \ _ @ Writing)
  [] Deny(publish, Writing)

InReview =
     Permit(review, \ v @ if v == approved then Approved else if v == rejected then Writing else InReview)
  [] Permit(other, \ _ @ InReview)
  [] Deny(publish, InReview)

Approved =
     Permit(publish, \ v @ if v == done then SKIP else Approved)
  [] Permit(other, \ _ @ Approved)
