-- The fallback is an action like any other: here the policy lets the writer do it once.
datatype Act = appended | replaced | other
datatype Value = done | failed
Returns(_) = {done, failed}

Policy = Permit(other, \ _ @ STOP)

Agent  = ControllableCHAOS
System = prioritise(Agent [| {|attempt, allow, deny, result, refuse|} |] ComplierGuard(Policy),
                    <{|attempt|}, {refuse}>)
