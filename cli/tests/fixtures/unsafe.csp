-- Not admissible: its own assertion says replacing comes only after appending, and the policy
-- allows a replace first.
datatype Act = appended | replaced
datatype Value = done | failed
Returns(_) = {done, failed}

Policy = Permit(appended, \ _ @ Policy) [] Permit(replaced, \ _ @ Policy)
AfterAppend = allow.appended -> Appended
Appended = allow.appended -> Appended [] allow.replaced -> AfterAppend
assert AfterAppend [T= System \ diff(Events, {|allow|})
