-- The writer appends, then replaces, in turn. `other` (the unit's fallback) is always denied;
-- anything else out of turn is refused.
datatype Act = appended | replaced | other
datatype Value = done | failed
Returns(_) = {done, failed}

Policy  = Append
Append  = Permit(appended, \ _ @ Replace) [] Deny(other, Append)
Replace = Permit(replaced, \ _ @ Append) [] Deny(other, Replace)
