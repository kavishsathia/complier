-- complier demo contract for Claude Code.
--
-- Events are Claude Code tool names. Only tools that appear in this file are
-- constrained; every other tool (Bash, TodoWrite, WebFetch, ...) runs as usual.
--
-- Rule: Claude has to read something before it can change files.

MAIN = Explore

Explore = Read -> Informed
       [] Grep -> Explore
       [] Glob -> Explore

Informed = Read -> Informed
        [] Grep -> Informed
        [] Glob -> Informed
        [] Edit -> Informed
        [] Write -> Informed
